DEFAULT = {"page_id": PAGE_ID, "mode": "off", "testers": [], "media_manifest": "/root/fb-ailla-tester/media-approved.json",
           "poll_seconds": 8, "pause_minutes_after_human": 120}


def cfg() -> dict:
    try:
        c = {**DEFAULT, **json.loads(CFG.read_text())}
    except FileNotFoundError:
        c = dict(DEFAULT)
    if c["page_id"] != PAGE_ID:
        raise SystemExit("Cau hinh sai page")
    if c["mode"] not in ("off", "tester"):
        raise SystemExit("Che do chi duoc la off hoac tester")
    return c


def save_cfg(c: dict) -> None:
    CFG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CFG.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(c, f, indent=2, ensure_ascii=False)
    os.replace(tmp, CFG)


def log(event: str, **kw) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    row = {"t": datetime.now(timezone.utc).isoformat(timespec="seconds"), "event": event, **kw}
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")


def token() -> str:
    pages = json.loads(PAGES_CFG.read_text())["pages"]
    p = next((x for x in pages if x.get("id") == PAGE_ID), None)
    if not p or not p.get("token"):
        raise SystemExit("Khong co token page")
    return p["token"]


def graph(method: str, path: str, params: dict | None = None, body: bytes | None = None, headers: dict | None = None) -> dict:
    q = dict(params or {})
    q["access_token"] = token()
    url = f"{GRAPH}/{path}?" + urllib.parse.urlencode(q)
    req = urllib.request.Request(url, data=body, method=method, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=180) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            err = json.load(e).get("error", {})
        except Exception:
            err = {}
        raise RuntimeError(f"Facebook {e.code}: {err.get('message', '')[:300]} (code {err.get('code')}/{err.get('error_subcode')})")


def multipart(fields: dict, filename: str, data: bytes, mime: str) -> tuple[bytes, str]:
    b = uuid.uuid4().hex
    out = b""
    for k, v in fields.items():
        out += f'--{b}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode()
    out += (f'--{b}\r\nContent-Disposition: form-data; name="filedata"; filename="{filename}"\r\n'
            f'Content-Type: {mime}\r\n\r\n').encode() + data + f"\r\n--{b}--\r\n".encode()
    return out, f"multipart/form-data; boundary={b}"


def need_tester(psid: str) -> None:
    c = cfg()
    if c["mode"] != "tester":
        raise SystemExit("Che do dang tat (off)")
    if psid not in c["testers"]:
        raise SystemExit("Nguoi nhan khong nam trong danh sach tester - tu choi gui")


def typing(psid: str, on: bool = True) -> None:
    try:
        graph("POST", "me/messages", body=json.dumps({
            "recipient": {"id": psid}, "sender_action": "typing_on" if on else "typing_off"}).encode(),
            headers={"Content-Type": "application/json"})
    except Exception:  # noqa: BLE001
        pass


def send_text(psid: str, text: str, human_delay: bool = True) -> dict:
    need_tester(psid)
    if human_delay:
        typing(psid)
        time.sleep(min(6.0, 1.0 + len(text) / 70.0))
    r = graph("POST", "me/messages", body=json.dumps({
        "recipient": {"id": psid}, "messaging_type": "RESPONSE", "message": {"text": text[:1900]}}).encode(),
        headers={"Content-Type": "application/json"})
    mine_add(r.get("message_id", ""))
    log("send_text", to_hash=psid[-4:], chars=len(text))
    return r


def media_manifest() -> dict:
    c = cfg()
    try:
        return json.loads(Path(c["media_manifest"]).read_text())
    except FileNotFoundError:
        return {}


def send_media(psid: str, code: str) -> dict:
    need_tester(psid)
    m = media_manifest().get(code)
    if not m or m.get("status") != "APPROVED-TEST":
        raise SystemExit(f"Media {code} chua duoc duyet")
    path = Path(m["path"])
    data = path.read_bytes()
    mime = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
    kind = "video" if mime.startswith("video") else "image" if mime.startswith("image") else None
    if not kind or len(data) > 24 * 1024 * 1024:
        raise SystemExit("Loai hoac dung luong media khong hop le")
    body, ctype = multipart({
        "recipient": json.dumps({"id": psid}), "messaging_type": "RESPONSE",
        "message": json.dumps({"attachment": {"type": kind, "payload": {"is_reusable": False}}})}, path.name, data, mime)
    r = graph("POST", "me/messages", body=body, headers={"Content-Type": ctype})
    mine_add(r.get("message_id", ""))
    log("send_media", to_hash=psid[-4:], code=code, kind=kind, bytes=len(data))
    return r


def find(code: str) -> None:
    data = graph("GET", f"{PAGE_ID}/conversations", {
        "fields": "participants,messages.limit(5){message,from,created_time}", "limit": 25})
    for conv in data.get("data", []):
        for msg in (conv.get("messages") or {}).get("data", []):
            if code in (msg.get("message") or ""):
                for p in conv["participants"]["data"]:
                    if p["id"] != PAGE_ID:
                        print(json.dumps({"psid": p["id"], "found_at": msg.get("created_time")}))
                        return
    print(json.dumps({"psid": None}))


MINE = Path("/root/fb-ailla-tester/mine.json")


def mine_add(mid: str) -> None:
    try:
        v = json.loads(MINE.read_text())
    except (FileNotFoundError, ValueError):
        v = []
    v.append(mid)
    MINE.write_text(json.dumps(v[-300:]))


def mine_has(mid: str) -> bool:
    try:
        return mid in json.loads(MINE.read_text())
    except (FileNotFoundError, ValueError):
        return False


def state() -> dict:
    try:
        return json.loads(STATE.read_text())
    except (FileNotFoundError, ValueError):
        return {"seen": {}, "pause": {}}


def save_state(s: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(s))


