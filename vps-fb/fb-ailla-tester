def ask_agent(psid: str, text: str, history: str | None = None) -> str:
    kichban, cat = kb()
    script = (kichban.SCRIPT.read_text(encoding="utf-8"))
    framed = (RULES + kichban.catalog_for_agent(cat)
              + "\n\n===== KỊCH BẢN V5 ĐẦY ĐỦ (để bạn hiểu luồng, bạn không được chép lại nội dung) =====\n" + script
              + ("\n\n===== LỊCH SỬ HỘI THOẠI THẬT TRÊN PAGE (cũ → mới; KHÁCH = khách nhắn, PAGE = tin page đã gửi) =====\n" + (history or "(chưa có tin nào trước đó)") if history is not None else "")
              + "\n\n===== TIN KHÁCH VỪA NHẮN =====\n" + text
              + "\n\nChỉ trả về các thẻ [..], không viết gì khác.")
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False, encoding="utf-8") as f:
        f.write(framed)
        path = f.name
    try:
        p = subprocess.run(["openclaw", "agent", "--agent", AGENT, "--session-key", f"agent:{AGENT}:fb-kb-{psid[-6:]}" + (f"-{int(time.time())}" if history is not None else ""),
                            "--message-file", path, "--json", "--timeout", "180"],
                           capture_output=True, text=True, timeout=240,
                           env={**os.environ, "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR", "/run/user/0")})
    finally:
        os.unlink(path)
    if p.returncode != 0:
        raise RuntimeError((p.stderr or p.stdout)[-300:])
    out = []
    for x in ((json.loads(p.stdout).get("result") or {}).get("payloads") or []):
        if isinstance(x, dict) and x.get("text"):
            out.append(x["text"])
    return "\n".join(out).strip()


