PAGE_ID = "105017945992971"
GRAPH = "https://graph.facebook.com/v26.0"
CFG = Path("/root/.config/openclaw/fb-ailla-tester.json")
PAGES_CFG = Path("/root/.config/openclaw/facebook-pages.json")
LOG = Path("/root/fb-ailla-tester/log.jsonl")
