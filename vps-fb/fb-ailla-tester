FU_GENERIC = ["/CHUNG_BAM_1", "/CHUNG_BAM_2"]


def followup_codes(psid: str) -> list[str]:
    """Bám đuổi theo V5 mục VII (bột tẩy vạn năng, tối đa 2 lượt rồi dừng); sản phẩm khác dùng 2 câu chăm sóc chung của Pancake."""
    conv = conv_load().get(psid) or {}
    sent = conv.get("sent", [])
    prod = conv.get("product") or ""
    if "/BT_XACNHAN" in sent:
        return []
    if prod.startswith("bột tẩy"):
        return ["/BT_BAM_DAGIA1", "/BT_BAM_DAGIA2", "/BT_BAM_DUNG2"] if "/BT_GIA" in sent else ["/BT_BAM_CHUATV1", "/BT_BAM_CHUATV2", "/BT_BAM_DUNG1"]
    return FU_GENERIC


def maybe_followup(psid: str, ordered: list, s: dict, c: dict) -> None:
    """Khách im lặng sau tin của bot: nhắc theo lịch (mặc định 10 phút, rồi 30, rồi 60), trong cửa sổ 24 giờ, dừng khi nhân viên nhắn tay hoặc khách trả lời."""
    try:
        if not ordered:
            return
        last = ordered[-1]
        if (last.get("from") or {}).get("id") != PAGE_ID or not mine_has(last["id"]):
            return
        if s["pause"].get(psid, 0) > time.time():
            return
        cust = [m for m in ordered if (m.get("from") or {}).get("id") != PAGE_ID]
        if not cust:
            return
        now = datetime.now(timezone.utc)
        t_of = lambda m: datetime.fromisoformat(m["created_time"].replace("+0000", "+00:00"))
        if (now - t_of(cust[-1])).total_seconds() > WINDOW_SECONDS:
            return
        anchor = cust[-1]["id"]
        fu = s.setdefault("fu", {})
        st = fu.get(psid) or {}
        n = st.get("n", 0) if st.get("anchor") == anchor else 0
        codes = followup_codes(psid)
        if n >= len(codes):
            return
        mins = c.get("followup_minutes", [10, 30, 60])
        if (now - t_of(last)).total_seconds() < mins[min(n, len(mins) - 1)] * 60:
            return
        fu[psid] = {"anchor": anchor, "n": n + 1}
        save_state(s)
        log("followup", to_hash=psid[-4:], n=n + 1, code=codes[n])
        deliver(psid, f"[XUNG:{get_xung(psid)}]\n[MA:{codes[n]}]", "")
    except Exception as e:  # noqa: BLE001
        log("followup_error", why=str(e)[:150])


def run() -> None:
    errors = 0
    last_ok = time.time()
    alerted = False
    while True:
        c = cfg()
        if c["mode"] == "tester" and c["testers"]:
            s = state()
            try:
                data = graph("GET", f"{PAGE_ID}/conversations", {
                    "fields": "participants,updated_time,messages.limit(14){id,message,from,created_time,attachments}", "limit": 15})
                for conv in data.get("data", []):
                    psid = next((p["id"] for p in conv["participants"]["data"] if p["id"] != PAGE_ID), None)
                    if psid not in c["testers"]:
                        continue
                    ordered = list(reversed((conv.get("messages") or {}).get("data", [])))
                    pending = []   # tin khach moi chua xu ly
                    last_inbound_age = 1e9
                    for idx, m in enumerate(ordered):
                        if m["id"] in s["seen"].get(psid, []):
                            continue
                        is_page = (m.get("from") or {}).get("id") == PAGE_ID
                        if is_page:
                            s["seen"].setdefault(psid, []).append(m["id"])
                            if SYSTEM_NOTE.search(m.get("message") or "") or not (m.get("message") or m.get("attachments")):
                                continue
                            if not mine_has(m["id"]):
                                s["pause"][psid] = time.time() + c["pause_minutes_after_human"] * 60
                                log("human_takeover", to_hash=psid[-4:])
                            continue
                        age = (datetime.now(timezone.utc) - datetime.fromisoformat(m["created_time"].replace("+0000", "+00:00"))).total_seconds()
                        last_inbound_age = min(last_inbound_age, age)
                        pending.append((idx, m, age))
                    if not pending and c.get("followup", True):
                        maybe_followup(psid, ordered, s, c)
                    if not pending:
                        continue
                    # Gom cac tin khach nhan lien nhau: cho khach go xong (debounce) roi tra loi 1 lan
                    if last_inbound_age < c.get("debounce_seconds", 6):
                        continue
                    for _, m, _ in pending:
                        s["seen"].setdefault(psid, []).append(m["id"])
                    s["seen"][psid] = s["seen"][psid][-80:]
                    fresh = [(i, m, a) for i, m, a in pending if a <= 600 and a <= WINDOW_SECONDS]
                    if not fresh or s["pause"].get(psid, 0) > time.time():
                        save_state(s)
                        continue
                    texts = []
                    for _, m, _ in fresh:
                        t = (m.get("message") or "").strip()
                        if (m.get("attachments") or {}).get("data"):
                            t += " [khách gửi kèm ảnh/video - agent chưa xem được nội dung]"
                        if t.strip():
                            texts.append(t.strip())
                    if not texts:
                        save_state(s)
                        continue
                    text = "\n".join(texts)
                    first_idx = fresh[0][0]
                    hist_lines = []
                    for hm in ordered[max(0, first_idx - 12):first_idx]:
                        who = "PAGE" if (hm.get("from") or {}).get("id") == PAGE_ID else "KHÁCH"
                        body = (hm.get("message") or "").strip()
                        if not body and (hm.get("attachments") or {}).get("data"):
                            body = "(gửi ảnh/video)"
                        if body:
                            hist_lines.append(f"{who}: {body[:500]}")
                    save_state(s)
                    log("inbound", from_hash=psid[-4:], chars=len(text), merged=len(texts))
                    hist = "\n".join(hist_lines) + ("\n" if hist_lines else "") + "[TRẠNG THÁI HỆ THỐNG] " + conv_summary(psid)
                    reply = ask_agent(psid, text, hist)
                    deliver(psid, reply, text)
                    conv_note(psid, [x.strip() for x in re.findall(r"\[MA:(/[A-Z_0-9]+)", reply or "")])
                errors = 0
                last_ok = time.time()
                alerted = False
            except Exception as e:  # noqa: BLE001
                errors += 1
                log("error", why=str(e)[:200], streak=errors)
                if errors >= 5 and not alerted:
                    alerted = True
                    alert(f"Dịch vụ trả lời page lỗi liên tiếp {errors} lần: {str(e)[:150]}")
            save_state(s)
        time.sleep(int(c["poll_seconds"]))


