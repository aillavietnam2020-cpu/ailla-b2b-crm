EMOJI = re.compile("[\U0001F000-\U0001FAFF\u2600-\u27BF\u2B00-\u2BFF\uFE0F\u200d\u2022\u25CF\u25AA\u25AB]")


def one_block(parts: list[str]) -> str:
    """Gop tat ca cau mau cua luot nay thanh 1 doan dai: khong icon, khong xuong dong, khong dau in dam."""
    t = " ".join(parts).replace("**", "")
    t = EMOJI.sub("", t)
    t = re.sub(r"\s*\n\s*", " ", t)
    return re.sub(r" {2,}", " ", t).strip()


def chunks(text: str, limit: int = 1800) -> list[str]:
    out = []
    while len(text) > limit:
        cut = max(text.rfind(". ", 0, limit), text.rfind("? ", 0, limit), text.rfind("! ", 0, limit))
        cut = cut + 1 if cut > 300 else limit
        out.append(text[:cut].strip())
        text = text[cut:].strip()
    if text:
        out.append(text)
    return out


def sale_text(t: str) -> str:
    """Giu nguyen cach trinh bay cua sale (icon, xuong dong). Chi bo dau ** cua markdown vi Messenger khong hien in dam."""
    return t.replace("**", "").strip()


def deliver(psid: str, reply: str, asked: str = "") -> None:
    kichban, cat = kb()
    c = cfg()
    dirs = DIRECTIVE.findall(reply or "")
    if not dirs:
        log("no_directive", raw_chars=len(reply or ""))
        note_to_tester(psid, "Agent không chọn được câu mẫu nào cho tin này, đã dừng và không gửi gì cho khách. Tin khách: " + asked[:200])
        return
    block_mode = c.get("format") == "block"
    parts: list[str] = []

    def out(text: str) -> None:
        for piece in chunks(sale_text(text), 1900):
            send_text(psid, piece)
            time.sleep(1.2)

    def media_for(code: str) -> None:
        if not c.get("send_media"):
            return
        try:
            send_media(psid, code)
        except (SystemExit, RuntimeError):
            log("media_missing", code=code)

    for kind, val in dirs:
        val = val.strip()
        if kind == "XUNG":
            set_xung(psid, "anh" if "anh" in val.lower() else "chị")
        elif kind == "HOI_CHI":
            log("ask_boss", why=val[:200])
            note_to_tester(psid, "Câu này chưa có trong kịch bản, agent dừng và hỏi chị Hoa: " + val[:600])
        elif kind == "MA":
            fields = [x.strip() for x in val.split("|")]
            code = fields[0]
            if code not in cat:
                log("unknown_code", code=code[:40])
                continue
            if code in MEDIA_INTRO and not any(
                    media_manifest().get(m, {}).get("status") in ("APPROVED-TEST", "APPROVED-LIVE") for m in MEDIA_INTRO[code]):
                # Cau mau chi de gioi thieu anh/video ("em gui chi xem feedback...") ma chua co file duoc duyet: bo qua, khong hua suong
                log("skip_media_intro", code=code)
                continue
            msgs = kichban.render(cat, code, fields[1:], get_xung(psid))
            log("script_code", code=code)
            if block_mode:
                parts.extend(msgs)
                continue
            for m in msgs:
                out(m)
            for mcode in cat[code]["media"]:
                if not mcode.startswith("NOTE:"):
                    media_for(mcode)
        elif kind == "MEDIA":
            if not block_mode:
                media_for(val)
    if block_mode and parts:
        for piece in chunks(one_block(parts)):
            send_text(psid, piece)
            time.sleep(1.2)
    log("delivered", mode="block" if block_mode else "sale")


def compose(psid: str, reply: str) -> str:
    """Dung cho khung chat web: doi cac the agent chon thanh van ban (nguyen van tu kich ban), khong gui di dau."""
    kichban, cat = kb()
    dirs = DIRECTIVE.findall(reply or "")
    if not dirs:
        return "(Agent không chọn được câu mẫu nào cho tin này, em dừng và hỏi chị.)"
    xung = get_xung(psid)
    out = []
    for kind, val in dirs:
        val = val.strip()
        if kind == "XUNG":
            xung = "anh" if "anh" in val.lower() else "chị"
            set_xung(psid, xung)
        elif kind == "HOI_CHI":
            out.append("(Chưa có trong kịch bản, em dừng và hỏi chị Hoa: " + val[:600] + ")")
        elif kind == "MA":
            parts = [x.strip() for x in val.split("|")]
            if parts[0] not in cat:
                continue
            out.extend(kichban.render(cat, parts[0], parts[1:], xung))
            for mc in cat[parts[0]]["media"]:
                if not mc.startswith("NOTE:"):
                    out.append("(Kịch bản gửi kèm: " + mc + ")")
        elif kind == "MEDIA":
            out.append("(Kịch bản chọn gửi: " + val + ")")
    return "\n\n".join(out)


CONV = Path("/root/fb-ailla-tester/conversations.json")


def conv_load() -> dict:
    try:
        return json.loads(CONV.read_text())
    except (FileNotFoundError, ValueError):
        return {}


def conv_note(psid: str, codes: list[str], inbound_ts: float | None = None) -> None:
    d = conv_load()
    c = d.setdefault(psid, {"product": None, "sent": [], "turns": 0})
    for code in codes:
        c["sent"].append(code)
        if code.startswith("/BT_"):
            c["product"] = "bột tẩy vạn năng"
        elif code.startswith("/TL_"):
            c["product"] = "tẩy lồng máy giặt / tẩy mốc gioăng"
    c["sent"] = c["sent"][-40:]
    c["turns"] = c.get("turns", 0) + 1
    c["last_reply_at"] = time.time()
    CONV.write_text(json.dumps(d, ensure_ascii=False))


def conv_summary(psid: str) -> str:
    c = conv_load().get(psid)
    if not c:
        return "(khách mới, chưa gửi mã nào)"
    return f"sản phẩm đang tư vấn: {c.get('product') or 'chưa rõ'}; các mã đã gửi (cũ→mới): {', '.join(c['sent'][-15:]) or 'chưa có'}; số lượt đã trả lời: {c.get('turns', 0)}"


