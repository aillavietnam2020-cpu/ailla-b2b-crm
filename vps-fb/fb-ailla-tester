        c = cfg()
        if a[1] not in c["testers"]:
            c["testers"].append(a[1])
        save_cfg(c)
        print("da them tester")
    elif cmd in ("on", "off"):
        c = cfg()
        c["mode"] = "tester" if cmd == "on" else "off"
        save_cfg(c)
        print("mode =", c["mode"])
    elif cmd == "send-text":
        print(json.dumps(send_text(a[1], a[2])))
    elif cmd == "send-media":
        print(json.dumps(send_media(a[1], a[2])))
    elif cmd == "run":
        run()
    else:
        print(__doc__)


