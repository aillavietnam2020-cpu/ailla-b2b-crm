#!/usr/bin/env python3
"""abos - cầu nối agent OpenClaw với web ABOS. Chỉ đọc + gửi đề xuất.
Khoá lấy từ biến môi trường ABOS_AGENT_KEY (dạng agt_...). Địa chỉ web: ABOS_URL (mặc định https://vanhanh.ailla.vn).
"""
import json, os, sys, urllib.request, urllib.parse, urllib.error

URL = os.environ.get("ABOS_URL", "https://ailla-b2b-crm.aillavietnam2020.workers.dev").rstrip("/")
KEY = os.environ.get("ABOS_AGENT_KEY", "")
AS = ""
DLG = os.environ.get("ABOS_DLG", "")


def load_key():
    """Khoá của từng agent nằm ở /root/.config/abos/<mã agent>.key (chị dán bằng lệnh abos-khoa, chmod 600)."""
    global KEY
    if KEY:
        return
    if AS and AS.replace("-", "").isalnum():
        try:
            KEY = open(f"/root/.config/abos/{AS}.key", encoding="utf-8").read().strip()
        except OSError:
            pass


def call(path, params=None, body=None):
    load_key()
    if not KEY.startswith("agt_"):
        sys.exit("Agent này chưa có khoá đọc web. Báo chị Hoa dán khoá bằng lệnh abos-khoa.")
    q = ("?" + urllib.parse.urlencode({k: v for k, v in (params or {}).items() if v not in (None, "")})) if params else ""
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(URL + "/api/agent" + path + q, data=data, method="POST" if body is not None else "GET")
    req.add_header("Authorization", "Bearer " + KEY)
    req.add_header("User-Agent", "abos-agent/1")
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            out = json.load(r)
    except urllib.error.HTTPError as e:
        try:
            msg = json.load(e).get("error", {}).get("message", "")
        except Exception:
            msg = ""
        sys.exit(f"Web trả lỗi {e.code}: {msg}")
    except Exception as e:
        sys.exit(f"Không nối được web: {e}")
    print(json.dumps(out, ensure_ascii=False))


def act(method, path, body):
    """Ghi dữ liệu thay người: chỉ chạy được khi có giấy ủy quyền (--dlg) do web cấp lúc chị Thảo vừa nhắn. Web tự từ chối nếu sai."""
    load_key()
    if not KEY.startswith("agt_"):
        sys.exit("Agent này chưa có khoá đọc web. Báo chị Hoa dán khoá bằng lệnh abos-khoa.")
    dlg = DLG if DLG.startswith("dlg_") else "tg"  # không có giấy trong tin web thì thử giấy theo tin Telegram; web tự từ chối nếu không có người được chỉ định vừa nhắn
    method = method.upper()
    if method not in ("GET", "POST", "PUT") or not path.startswith("/api/"):
        sys.exit("Dùng: abos --as ID --dlg GIẤY act GET|POST|PUT /api/... ['{json}']")
    data = body.encode("utf-8") if body else None
    req = urllib.request.Request(URL + path, data=data, method=method)
    req.add_header("Authorization", "Bearer " + KEY)
    req.add_header("X-Delegation", dlg)
    req.add_header("User-Agent", "abos-agent/1")
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            print(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        try:
            msg = json.load(e).get("error", {}).get("message", "")
        except Exception:
            msg = ""
        sys.exit(f"Web trả lỗi {e.code}: {msg}")
    except Exception as e:
        sys.exit(f"Không nối được web: {e}")


def opts(argv):
    o, i = {}, 0
    while i < len(argv):
        if argv[i].startswith("--") and i + 1 < len(argv):
            o[argv[i][2:]] = argv[i + 1]
            i += 2
        else:
            i += 1
    return o


def main():
    args = sys.argv[1:]
    global AS, DLG
    while len(args) >= 2 and args[0] in ("--as", "--dlg"):
        if args[0] == "--as":
            AS = args[1]
        else:
            DLG = args[1]
        args = args[2:]
    if not args:
        sys.exit("Dùng: abos --as <mã agent> me|orders|order|customers|customer|debts|payments|shortages|kho-alerts|kho-stock|kho-nxt|kho-docs|kho-doc|kho-lots|kho-online|products|act|read|pha-che|mkt-cards|mkt-orders|mkt-ads|xuong|events|propose")
    cmd, rest = args[0], args[1:]
    if cmd == "read":
        # Trợ lý toàn diện (AILLA Center): ĐỌC mọi trang web như chủ doanh nghiệp, chỉ GET, không ghi gì
        if not rest or not rest[0].startswith("/api/"):
            sys.exit("Dùng: abos --as main read /api/... (chỉ xem)")
        load_key()
        if not KEY.startswith("agt_"):
            sys.exit("Agent này chưa có khoá đọc web.")
        req = urllib.request.Request(URL + rest[0], method="GET")
        req.add_header("Authorization", "Bearer " + KEY)
        req.add_header("X-Read-All", "1")
        req.add_header("User-Agent", "abos-agent/1")
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                print(r.read().decode("utf-8")[:60000])
        except urllib.error.HTTPError as e:
            try:
                msg = json.load(e).get("error", {}).get("message", "")
            except Exception:
                msg = ""
            sys.exit(f"Web trả lỗi {e.code}: {msg}")
        except Exception as e:
            sys.exit(f"Không nối được web: {e}")
        return
    if cmd == "act":
        if len(rest) < 2:
            sys.exit("Dùng: abos --as ID --dlg GIẤY act GET|POST|PUT /api/... ['{json}']")
        return act(rest[0], rest[1], rest[2] if len(rest) > 2 else "")
    o = opts(rest)
    if cmd == "me":
        call("/me")
    elif cmd == "orders":
        call("/orders", {"flow": o.get("flow"), "kho_status": o.get("kho-status"),
                         "stuck_hours": o.get("stuck-hours"), "customer_id": o.get("customer")})
    elif cmd == "order" and rest:
        call("/orders/" + urllib.parse.quote(rest[0], safe=""))
    elif cmd == "customer" and rest:
        call("/customers/" + urllib.parse.quote(rest[0], safe=""))
    elif cmd == "customers":
        call("/customers", {"q": o.get("q"), "limit": o.get("limit")})
    elif cmd == "debts":
        call("/debts", {"loc": o.get("loc"), "limit": o.get("limit")})
    elif cmd == "payments":
        call("/payments", {"pending": o.get("pending"), "customer_id": o.get("customer"), "limit": o.get("limit")})
    elif cmd == "pha-che":
        call("/kho/pha-che", {"limit": o.get("limit")})
    elif cmd == "mkt-cards":
        call("/mkt/cards", {"step": o.get("step"), "kenh": o.get("kenh"), "limit": o.get("limit")})
    elif cmd == "mkt-orders":
        call("/mkt/orders")
    elif cmd == "mkt-ads":
        call("/mkt/ads")
    elif cmd == "xuong":
        call("/xuong", {"limit": o.get("limit")})
    elif cmd == "shortages":
        call("/shortages")
    elif cmd == "kho-alerts":
        call("/kho/alerts")
    elif cmd == "kho-stock":
        call("/kho/stock", {"cls": o.get("cls"), "q": o.get("q"), "neg": o.get("neg"),
                            "nonzero": o.get("nonzero"), "limit": o.get("limit")})
    elif cmd == "kho-docs":
        call("/kho/docs", {"type": o.get("type"), "from": o.get("from"), "to": o.get("to"), "q": o.get("q"), "limit": o.get("limit")})
    elif cmd == "kho-doc" and rest:
        call("/kho/docs/" + urllib.parse.quote(rest[0], safe=""))
    elif cmd == "kho-lots":
        call("/kho/lots", {"st": o.get("st"), "q": o.get("q"), "limit": o.get("limit")})
    elif cmd == "kho-online":
        call("/kho/online", {"from": o.get("from"), "to": o.get("to"), "channel": o.get("channel"), "limit": o.get("limit")})
    elif cmd == "products":
        call("/products", {"q": o.get("q"), "tier": o.get("tier"), "limit": o.get("limit")})
    elif cmd == "kho-nxt":
        call("/kho/nxt", {"from": o.get("from"), "to": o.get("to"), "cls": o.get("cls"),
                          "q": o.get("q"), "limit": o.get("limit")})
    elif cmd == "events":
        call("/events", {"after": o.get("after"), "types": o.get("types"), "limit": o.get("limit")})
    elif cmd == "propose":
        need = ["kind", "route", "entity-type", "entity-id", "title", "dedupe"]
        miss = [k for k in need if not o.get(k)]
        if miss:
            sys.exit("Thiếu: " + ", ".join("--" + k for k in miss))
        call("/proposals", body={"kind": o["kind"], "route_to": o["route"], "entity_type": o["entity-type"],
                                 "entity_id": o["entity-id"], "title": o["title"], "body": o.get("body"),
                                 "dedupe_key": o["dedupe"]})
    else:
        sys.exit("Lệnh không có. Chạy abos không tham số để xem danh sách.")


main()
