{
  "name": "ailla-b2b-crm",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "AILLA B2B CRM - Cloudflare Worker + D1 + React (nội bộ Công ty CP TM & XNK AILLA Việt Nam)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "dev:node": "tsx scripts/dev-server.ts",
    "dev:node:fresh": "tsx scripts/dev-server.ts --fresh",
    "build": "tsc -b tsconfig.build.json && vite build",
    "preview": "wrangler dev --local",
    "typecheck": "tsc -b tsconfig.build.json --force",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply ailla_crm_dev --local",
    "db:migrate:dev": "wrangler d1 migrations apply ailla_crm_dev --remote",
    "db:migrate:staging": "wrangler d1 migrations apply ailla_crm_staging --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply ailla_crm_prod --remote --env production",
    "db:seed:local": "wrangler d1 execute ailla_crm_dev --local --file=./seed/dev_seed.sql",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "import:preview": "tsx scripts/import/cli.ts preview",
    "import:commit": "tsx scripts/import/cli.ts commit",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:prod": "npm run build && wrangler deploy --env production",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.123.0",
    "xlsx": "^0.18.5"
  }
}
